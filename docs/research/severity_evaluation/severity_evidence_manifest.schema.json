{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autodentifyr.local/schemas/severity-evidence-manifest-v1.json",
  "title": "AutoDentifyr severity evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_version", "frozen_at", "hash_algorithm", "manifest_serialization", "access_controlled_location", "rubric_version", "corpus_identity", "selection_frozen_at", "final_test_opened_at", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "package_version": {"type": "string", "minLength": 1},
    "frozen_at": {"type": "string", "format": "date-time"},
    "hash_algorithm": {"const": "sha256"},
    "manifest_serialization": {"const": "exact_utf8_bytes"},
    "access_controlled_location": {"type": "string", "minLength": 1},
    "rubric_version": {"type": "string", "minLength": 1},
    "corpus_identity": {"type": "string", "minLength": 1},
    "selection_frozen_at": {"type": "string", "format": "date-time"},
    "final_test_opened_at": {"type": ["string", "null"], "format": "date-time"},
    "files": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "bytes", "sha256"],
        "properties": {
          "role": {"type": "string"},
          "path": {"type": "string", "pattern": "^[^/][^\\\\]*\\.csv$"},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
